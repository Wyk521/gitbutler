{
	"productName": "RepoScope Desktop Nightly",
	"identifier": "com.reposcope.desktop.nightly",
	"build": {
		"beforeBuildCommand": "pnpm build:desktop -- --mode production"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/nightly/32x32.png",
			"icons/nightly/128x128.png",
			"icons/nightly/128x128@2x.png",
			"icons/nightly/icon.icns",
			"icons/nightly/icon.ico"
		]
	},
	"plugins": {},
	"app": {
		"security": {
			"csp": {
				"default-src": "'self'",
				"img-src": "'self' asset: tauri://localhost data: blob:",
				"connect-src": "'self' ipc: data:",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'"
			}
		}
	}
}
